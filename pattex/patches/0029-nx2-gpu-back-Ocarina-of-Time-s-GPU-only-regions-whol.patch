From 24b7b617186df13a3a32950a2993afde17a13526 Mon Sep 17 00:00:00 2001
From: pattex67 <33281022+pattex67@users.noreply.github.com>
Date: Thu, 5 Nov 2026 16:09:05 +0100
Subject: [PATCH] nx2:gpu: back Ocarina of Time's GPU-only regions whole

Backed as written, its 305 MiB regions read as green in its movies and 3D (as Mario Kart World's
tour movie did on AMD); backed whole, the intro movie, title, prologue and first cutscene show.
Same per-title switch as Yoshi; EDEN_NX2_GPU_ONLY_LAZY=1 turns lazy backing back on.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/core/hle/service/nx2_gsv.h | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/src/core/hle/service/nx2_gsv.h b/src/core/hle/service/nx2_gsv.h
index 410abbfd5a..c20017c142 100644
--- a/src/core/hle/service/nx2_gsv.h
+++ b/src/core/hle/service/nx2_gsv.h
@@ -1061,7 +1061,9 @@ private:
     // EDEN_NX2_GPU_ONLY_LAZY=0 backs GPU-only regions whole, as before.
     // Yoshi and the Mysterious Book docked: with its large regions backed as written, two of its
     // shaders read as zeros right after the intro movie and the game aborts (2162-0001); backed
-    // whole it plays. EDEN_NX2_GPU_ONLY_LAZY=1 turns lazy backing back on for it too.
+    // whole it plays. The Legend of Zelda: Ocarina of Time: its movies and 3D read as green, as
+    // Mario Kart World's tour movie did, from its 305 MiB regions backed as written; backed whole
+    // they show. EDEN_NX2_GPU_ONLY_LAZY=1 turns lazy backing back on for them too.
     static bool LazyGpuOnlyRegions() {
         static const int forced = [] {
             const char* value = std::getenv("EDEN_NX2_GPU_ONLY_LAZY");
@@ -1070,7 +1072,8 @@ private:
         if (forced >= 0) {
             return forced == 1;
         }
-        return Tegra::g_nx2_program_id.load(std::memory_order_relaxed) != 0x0400245021D2C000ULL;
+        const u64 program = Tegra::g_nx2_program_id.load(std::memory_order_relaxed);
+        return program != 0x0400245021D2C000ULL && program != 0x0400486024DEC000ULL;
     }
 
     // EDEN_NX2_GPU_ONLY_LAZY_MIN=<MiB>: GPU-only regions smaller than that are backed whole even
-- 
2.51.0.windows.1

