From acbc0ff882968808e11fe7f5e8508a5836736dfa Mon Sep 17 00:00:00 2001
From: pattex67 <33281022+pattex67@users.noreply.github.com>
Date: Sun, 8 Nov 2026 13:50:27 +0100
Subject: [PATCH 14/18] texture_cache: unswizzle a layer with no guest bytes
 behind it as zeros

From MythosOfs/Orchid f2eb04babd (the texture part; the buffer cache part is
already covered here by Lichii #397): an image over a range that read as
empty started reading past the end of its input, at null for an empty one.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/video_core/texture_cache/util.cpp | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/src/video_core/texture_cache/util.cpp b/src/video_core/texture_cache/util.cpp
index 3b60866c26..fedb897593 100644
--- a/src/video_core/texture_cache/util.cpp
+++ b/src/video_core/texture_cache/util.cpp
@@ -919,7 +919,17 @@ boost::container::small_vector<BufferImageCopy, 16> UnswizzleImage(
 
         for (s32 layer = 0; layer < info.resources.layers; ++layer) {
             const std::span<u8> dst = output.subspan(host_offset);
-            const std::span<const u8> src = input.subspan(guest_offset + guest_layer_offset);
+            const size_t src_offset = guest_offset + guest_layer_offset;
+            if (src_offset >= input.size()) {
+                // No guest bytes behind this layer (an image over a range that read as empty):
+                // reading would start past the end of `input`, at null for an empty one
+                // (MythosOfs/Orchid f2eb04babd).
+                std::fill_n(dst.begin(), (std::min<size_t>)(host_bytes_per_layer, dst.size()), u8{0});
+                guest_layer_offset += layer_stride;
+                host_offset += host_bytes_per_layer;
+                continue;
+            }
+            const std::span<const u8> src = input.subspan(src_offset);
             if (!worker ||
                 info.type != ImageType::e2D || info.num_samples != 1 ||
                 !worker->TryUnswizzle(
