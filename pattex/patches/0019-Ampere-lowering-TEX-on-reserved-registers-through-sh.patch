From ffcdeeeb202767c505c487020614dc24bfc5a07c Mon Sep 17 00:00:00 2001
From: pattex67 <33281022+pattex67@users.noreply.github.com>
Date: Sun, 8 Nov 2026 14:42:14 +0100
Subject: [PATCH 19/22] Ampere lowering: TEX on reserved registers through
 shadow copies (Kirby Air Riders)

Kirby Air Riders' menu and race compute programs sample with TEX (0xf60, the
handle in a uniform register) into R243, with the coordinates' last value
there too; the register shadowing table had no TEX entry, so they were
rejected ("native register shadowing mode") and their dispatches skipped.
TEX now lists its operands as the lowering reads them: the packed
coordinates, LOD, offsets and depth reference over Ra and Rb, the results
in Rd and the second destination. Rb of 0xf60 is also checked for reserved
registers, as for 0xb60.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../frontend/ampere/lower_to_maxwell.h        |  2 +-
 .../frontend/ampere/register_pressure.h       | 24 +++++++++++++++++++
 2 files changed, 25 insertions(+), 1 deletion(-)

diff --git a/src/shader_recompiler/frontend/ampere/lower_to_maxwell.h b/src/shader_recompiler/frontend/ampere/lower_to_maxwell.h
index 0300f05458..72ee272331 100644
--- a/src/shader_recompiler/frontend/ampere/lower_to_maxwell.h
+++ b/src/shader_recompiler/frontend/ampere/lower_to_maxwell.h
@@ -308,7 +308,7 @@ inline LoweredProgram LowerToMaxwellWith(std::span<const Instruction> code, u32
             // Bits 32-39 name a register in register forms and in these opcodes: TEX/TLD, TXD's
             // gradients, and the data operand of the stores, ISBEWR (0x927), the global atomic
             // (0x9a8), RED (0x98e) and SURED (0x59f), all listed with operand 32 in RegisterPressure.
-            if (bit == 32 && insn.Bits(9, 3) != 1 && opcode != 0xb60 && opcode != 0xb66 && opcode != 0xb6c && opcode != 0xf6c && opcode != 0x986 && opcode != 0x987 && opcode != 0xf66 && opcode != 0x988 && opcode != 0x927 && opcode != 0x9a8 && opcode != 0x98e && opcode != 0x59f) continue;
+            if (bit == 32 && insn.Bits(9, 3) != 1 && opcode != 0xb60 && opcode != 0xf60 && opcode != 0xb66 && opcode != 0xb6c && opcode != 0xf6c && opcode != 0x986 && opcode != 0x987 && opcode != 0xf66 && opcode != 0x988 && opcode != 0x927 && opcode != 0x9a8 && opcode != 0x98e && opcode != 0x59f) continue;
             const u32 reg = insn.Bits(bit, 8);
             if (reg >= (uses_uniform_bank ? high_uniform_base : 246U) && reg < 255)
                 requires_shadow = true;
diff --git a/src/shader_recompiler/frontend/ampere/register_pressure.h b/src/shader_recompiler/frontend/ampere/register_pressure.h
index 121a9f2138..eff437c59f 100644
--- a/src/shader_recompiler/frontend/ampere/register_pressure.h
+++ b/src/shader_recompiler/frontend/ampere/register_pressure.h
@@ -242,6 +242,30 @@ inline RegisterPressure PrepareRegisterPressure(const Instruction& input, u32 re
         operand(24);
         break;
     }
+    case 0xb60:
+    case 0xf60: {
+        // TEX (0xf60: handle in a uniform register): the coordinates, then the LOD/bias, offsets
+        // and depth reference, packed over Ra and Rb as the lowering reads them (up to four as
+        // halves, five or more as 4 + n); the results in Rd (two, or all without a second
+        // destination) and the second destination. Kirby Air Riders' menu and race compute
+        // programs sample into R243 with the coordinates' last value there too.
+        constexpr std::array<u32, 8> coordinate_count{1, 2, 3, 3, 2, 3, 0, 4};
+        const u32 lod = input.Bits(87, 3);
+        const bool has_lod = lod == 2 || lod == 3 || lod == 6 || lod == 7;
+        const u32 count = coordinate_count[input.Bits(61, 3)] + (has_lod ? 1U : 0U) +
+                          input.Bits(76, 1) + input.Bits(78, 1);
+        const u32 in_a = count <= 4 ? (count + 1) / 2 : 4;
+        const u32 components = static_cast<u32>(std::popcount(input.Bits(72, 4)));
+        const bool split = input.Bits(64, 8) != 255;
+        const bool half = input.Bits(79, 1) != 0;
+        const u32 first = half ? 1U : split ? (std::min)(components, 2U) : components;
+        const u32 second = half ? 1U : components - (std::min)(components, 2U);
+        if (first != 0) operand(16, first);
+        if (split && second != 0) operand(64, second);
+        if (in_a != 0) operand(24, in_a);
+        if (count > in_a) operand(32, count - in_a);
+        break;
+    }
     case 0x381:
     case 0x386:
     case 0x981:
