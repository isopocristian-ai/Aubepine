-    const Id workgroup{
+    Id workgroup{
         ctx.OpCompositeExtract(ctx.U32[1], ctx.OpLoad(ctx.U32[3], ctx.workgroup_id), 0U)};
+    if (Sirit::ValidId(ctx.mesh_draw_base_push_constant)) {
+        // The draw's first workgroup (zero for a mesh stage that has a task stage).
+        const Id pointer{ctx.OpAccessChain(
+            ctx.TypePointer(spv::StorageClass::PushConstant, ctx.U32[1]),
+            ctx.mesh_draw_base_push_constant, ctx.Const(ctx.mesh_draw_base_member_index))};
+        workgroup = ctx.OpIAdd(ctx.U32[1], workgroup, ctx.OpLoad(ctx.U32[1], pointer));
+    }
