From 2b1069ab79aaf252d13e9cf737eb2f9d0bae5c9e Mon Sep 17 00:00:00 2001
From: pattex67 <33281022+pattex67@users.noreply.github.com>
Date: Wed, 4 Nov 2026 19:44:06 +0100
Subject: [PATCH 14/15] Yoshi mission shaders: I2F.F16/F32 of an immediate
 (0x906), LDGSTS.E.BYPASS.128 in both forms (0xfae, as upstream nx2 and
 Ahmedx360/Eden-NS2) with LDGDEPBAR (0x9af), UIADD3 carry into UP2 and above
 when not guarded

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../frontend/ampere/lower_to_maxwell.h        | 52 ++++++++++++++++++-
 1 file changed, 50 insertions(+), 2 deletions(-)

diff --git a/src/shader_recompiler/frontend/ampere/lower_to_maxwell.h b/src/shader_recompiler/frontend/ampere/lower_to_maxwell.h
index ae423e832..ee2ae6f43 100644
--- a/src/shader_recompiler/frontend/ampere/lower_to_maxwell.h
+++ b/src/shader_recompiler/frontend/ampere/lower_to_maxwell.h
@@ -1962,6 +1962,39 @@ inline LoweredProgram LowerToMaxwellWith(std::span<const Instruction> code, u32
             }
             break;
         }
+        case 0xfae: { // LDGSTS.E.BYPASS.128: a global-to-shared copy, done synchronously (as upstream
+            // nx2 does; the plain form as Ahmedx360/Eden-NS2 decoded it)
+            // [Ra.64 + imm12] to shared [Rd + s16 * 16] through R248-R251. A disabled load stores
+            // zeros. Two forms (control word 2 without the predicate and descriptor bits):
+            // 0x0c101c00 with a uniform descriptor (cache policy only), enabled by bits 87-89 and
+            // bit 70 inverting; 0x08101d00 with a plain address (Yoshi), bit 90 inverting.
+            const u32 global_address = insn.Bits(24, 8), shared_address = insn.Bits(16, 8);
+            const u32 control = insn.words[2] & ~(0x03800000U | 0x7fU);
+            const bool plain = control == 0x08101d00;
+            if (native_predicate != 7 || (global_address & 1) || global_address >= 246 ||
+                (insn.words[1] & 0xf000U) || (control != 0x0c101c00 && !plain) ||
+                (!plain && (insn.Bits(64, 6) >= 63 || (insn.Bits(64, 6) & 1))))
+                return fail(index, "native global-to-shared copy mode");
+            const u32 enable = insn.Bits(87, 3) | (insn.Bits(plain ? 90 : 70, 1) << 3);
+            const u32 global_immediate = insn.words[1] & 0xfff;
+            const s32 global_offset =
+                static_cast<s32>(global_immediate) - (global_immediate & 0x800 ? 0x1000 : 0);
+            const s32 shared_offset = static_cast<s32>(static_cast<s16>(insn.words[1] >> 16)) * 16;
+            for (u32 component = 0; component < 4; ++component) mov_imm(248 + component, 0);
+            if (enable != 15) {
+                emit(0xeed0000000000000ULL | (u64{enable} << 16) | 248 | (u64{global_address} << 8) |
+                     (u64{static_cast<u32>(global_offset) & 0xffffffU} << 20) | (u64{1} << 45) |
+                     (u64{6} << 48));
+            }
+            emit(0xef58000000000000ULL | predicate | 248 | (u64{shared_address} << 8) |
+                 (u64{static_cast<u32>(shared_offset) & 0xffffffU} << 20) | (u64{6} << 48));
+            break;
+        }
+        case 0x9af: // LDGDEPBAR: commits a copy group, already complete (see 0xfae).
+            if (insn.words[0] != 0x79af || insn.words[1] || insn.words[2])
+                return fail(index, "native copy-group commit mode");
+            emit(0xef98000000000000ULL | predicate);
+            break;
         case 0x91a: // DEPBAR.LE SB5, 1: scoreboard wait, represented by IR data dependencies.
             if (insn.words[0] != 0x791a || (insn.words[1] & ~0xfc0U) != 0xd000 || insn.words[2]) {
                 return fail(index, "native dependency barrier mode");
@@ -2623,6 +2656,19 @@ inline LoweredProgram LowerToMaxwellWith(std::span<const Instruction> code, u32
                  (u64{half ? selector * 2 : selector} << 41));
             break;
         }
+        case 0x906: { // I2F.F16/F32 of a 32-bit immediate (Yoshi: I2F.F16.S32 Rd, -1)
+            // Bits 75-76 the result format (1 F16, 2 F32), 84-85 the source size (2: 32 bits), 74
+            // signed, 78-79 rounding: Maxwell I2F's bits 8-9, 10-11, 13 and 39-40. An F16 result
+            // goes to the low half with the high half zero, as on Maxwell.
+            const u32 format = insn.Bits(75, 2);
+            if ((format != 1 && format != 2) ||
+                (insn.words[2] & ~0xc400U) != (0x00200000U | (format << 11)))
+                return fail(index, "native immediate integer-to-float mode");
+            mov_imm(250, insn.words[1]);
+            emit(base(0x5cb8000000000000ULL) | (u64{format} << 8) | (u64{2} << 10) |
+                 (u64{insn.Bits(74, 1)} << 13) | (u64{250} << 20) | (u64{insn.Bits(78, 2)} << 39));
+            break;
+        }
         case 0x245: case 0x845: case 0xa45: case 0xc45: { // I2FP.F32.U32 (0x845: immediate, Yoshi)
             // Bits 78-79: rounding (RN/RM/RP/RZ), as Maxwell I2F's bits 39-40.
             if ((insn.words[2] & ~(0x400U | 0xc000U | (opcode == 0xc45 ? 0x08000000U : 0U))) != 0x00201000) return fail(index, "native packed integer-to-float format");
@@ -2956,8 +3002,10 @@ inline LoweredProgram LowerToMaxwellWith(std::span<const Instruction> code, u32
                 const u32 carry_out = insn.Bits(81, 3);
                 const u32 a = insn.Bits(24, 8);
                 if ((carry_in && carry_out != 7) || (opcode == 0x210 && (insn.words[1] & ~0xffU)) ||
-                    (rewritten_uniform && carry_out != 7 && carry_out > 1) ||
-                    (rewritten_uniform && carry_in && insn.Bits(87, 3) > 1 && insn.Bits(87, 3) != 7))
+                    // A UPn guard keeps its predicate in R253 too: then only UP0 and UP1.
+                    (rewritten_uniform && guarded_uniform && carry_out != 7 && carry_out > 1) ||
+                    (rewritten_uniform && guarded_uniform && carry_in && insn.Bits(87, 3) > 1 &&
+                     insn.Bits(87, 3) != 7))
                     return fail(index, "native integer carry mode");
                 if (opcode == 0x810) {
                     emit(0x1c00000000000000ULL | predicate | 250 | (u64{a} << 8) | (u64{insn.words[1]} << 20));
-- 
