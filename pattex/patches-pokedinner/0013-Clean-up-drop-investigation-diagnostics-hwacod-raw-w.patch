 src/core/hle/service/nx2_gsv.h                | 11 ++++-----
 src/video_core/dma_pusher.cpp                 | 16 ++-----------
 .../renderer_vulkan/vk_rasterizer.cpp         |  5 ++--
 src/video_core/shader_cache.cpp               | 23 +++++++++----------
 src/video_core/shader_cache.h                 | 12 ++++++----
 6 files changed, 28 insertions(+), 48 deletions(-)

