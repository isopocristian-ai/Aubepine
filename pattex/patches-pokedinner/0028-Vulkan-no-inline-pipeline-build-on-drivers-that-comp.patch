From 531872a942b00f2abf0400c4cf32af1f92347e42 Mon Sep 17 00:00:00 2001
From: pattex67 <33281022+pattex67@users.noreply.github.com>
Date: Thu, 5 Nov 2026 16:09:04 +0100
Subject: [PATCH] Vulkan: no inline pipeline build on drivers that compile one
 pipeline at a time

On AMD Windows (parallel compiles can break) the scheduler thread waits for the worker's build
instead of starting a second one beside it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/video_core/renderer_vulkan/vk_compute_pipeline.cpp  | 8 ++++++--
 src/video_core/renderer_vulkan/vk_graphics_pipeline.cpp | 8 ++++++--
 2 files changed, 12 insertions(+), 4 deletions(-)

diff --git a/src/video_core/renderer_vulkan/vk_compute_pipeline.cpp b/src/video_core/renderer_vulkan/vk_compute_pipeline.cpp
index 022d83cb43..4aa1241d23 100644
--- a/src/video_core/renderer_vulkan/vk_compute_pipeline.cpp
+++ b/src/video_core/renderer_vulkan/vk_compute_pipeline.cpp
@@ -304,9 +304,13 @@ bool ComputePipeline::Configure(Tegra::Engines::KeplerCompute& kepler_compute,
                          views_it);
 
     if (!is_built.load(std::memory_order::relaxed)) {
-        // Wait for the pipeline to be built, building it here if no worker has started it
+        // Wait for the pipeline to be built, building it here if no worker has started it.
+        // Not on drivers that compile one pipeline at a time (AMD on Windows, which can break
+        // with parallel compiles): a build here would run beside the worker's.
         scheduler.Record([this](vk::CommandBuffer) {
-            RunBuild();
+            if (!device.HasBrokenParallelShaderCompiling()) {
+                RunBuild();
+            }
             std::unique_lock lock{build_mutex};
             build_condvar.wait(lock, [this] { return is_built.load(std::memory_order::relaxed); });
         });
diff --git a/src/video_core/renderer_vulkan/vk_graphics_pipeline.cpp b/src/video_core/renderer_vulkan/vk_graphics_pipeline.cpp
index 0ca6f5af3d..0d761f7715 100644
--- a/src/video_core/renderer_vulkan/vk_graphics_pipeline.cpp
+++ b/src/video_core/renderer_vulkan/vk_graphics_pipeline.cpp
@@ -694,9 +694,13 @@ bool GraphicsPipeline::ConfigureDraw(const RescalingPushConstant& rescaling,
 
     scheduler.RequestRenderpass(texture_cache.GetFramebuffer());
     if (!is_built.load(std::memory_order::relaxed)) {
-        // Wait for the pipeline to be built, building it here if no worker has started it
+        // Wait for the pipeline to be built, building it here if no worker has started it.
+        // Not on drivers that compile one pipeline at a time (AMD on Windows, which can break
+        // with parallel compiles): a build here would run beside the worker's.
         scheduler.Record([this](vk::CommandBuffer) {
-            RunBuild();
+            if (!device.HasBrokenParallelShaderCompiling()) {
+                RunBuild();
+            }
             std::unique_lock lock{build_mutex};
             build_condvar.wait(lock, [this] { return is_built.load(std::memory_order::relaxed); });
         });
-- 
2.51.0.windows.1

